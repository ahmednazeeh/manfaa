# Manfaa — infrastructure environment (TEMPLATE)
#
# Copy to .env and fill in secrets. This file is committed; .env is not.
# Application secrets (DB, mail, queue) live in api/.env, not here.

APP_NAME=Manfaa
APP_DOMAIN=manfaa.app

# --- Hostnames (PLAN.md §14) -------------------------------------------------
# Sanctum stateful cookie auth requires every app under one parent domain.
WEB_HOST=manfaa.app
MERCHANT_HOST=merchant.manfaa.app
ADMIN_HOST=admin.manfaa.app
API_HOST=api.manfaa.app

SESSION_DOMAIN=.manfaa.app
SANCTUM_STATEFUL_DOMAINS=manfaa.app,merchant.manfaa.app,admin.manfaa.app

# --- Cloudflare --------------------------------------------------------------
# Token needs: Zone.DNS:Edit, Zone.Zone:Read (add Zone.SSL and Certificates:Edit
# if managing certs through the API).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_NAME=manfaa.app
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# --- TLS ---------------------------------------------------------------------
# .app is on the HSTS preload list: HTTPS is mandatory, there is no http://
# fallback in any browser, including for local testing against the real domain.
ACME_EMAIL=
ACME_DNS_PROVIDER=cloudflare
