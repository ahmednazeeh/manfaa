# --- secrets ---
.env
.env.*
!.env.example
*.pem
*.key
auth.json

# --- node / next ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.pnpm-store/

# --- laravel ---
/api/vendor/
/api/storage/*.key
/api/storage/framework/cache/*
/api/storage/framework/sessions/*
/api/storage/framework/views/*
/api/storage/logs/*
/api/bootstrap/cache/*
/api/public/storage
Homestead.yaml
Homestead.json

# --- build / os / editor ---
dist/
coverage/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# App download artifacts (the page and its images are committed; the APK is not).
download/public/*.apk

# The manfaa service user's $HOME is this directory (server isolation, 2026-08-21);
# pnpm/corepack/npm/psysh drop their caches here when builds run as that user.
.cache/
.config/
.npm/

# WooCommerce plugin: local dev store and tooling, never shipped
plugins/woocommerce/dev-site/
plugins/woocommerce/.tools/
plugins/woocommerce/manfaa-cashback/vendor/
plugins/woocommerce/manfaa-cashback/node_modules/
.android/
.flutter
.gradle/
.local/
.pub-cache/
.wp-cli/
# Built plugin zips + manifest are published artefacts, like the APKs
download/public/woocommerce/
plugins/woocommerce/manfaa-cashback/.phpunit.result.cache

# Golden-test failure artefacts (diff images) are run debris, never source
mobile/*/test/failures/
