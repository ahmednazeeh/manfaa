{
  "name": "manfaa/woocommerce-cashback",
  "description": "Manfaa Cashback for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^6.9",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Manfaa\\Cashback\\": "src/"
    }
  },
  "config": {
    "allow-plugins": false
  },
  "scripts": {
    "test": "phpunit"
  },
  "autoload-dev": {
    "psr-4": {
      "Manfaa\\Cashback\\Tests\\": "tests/"
    }
  }
}
